{
  "name": "dogfight-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:ws --external:zod --external:pino --outfile=dist/index.js"
  },
  "dependencies": {
    "ws": "^8.23.0",
    "@dogfight/shared": "file:../shared",
    "pino": "^9.9.0",
    "zod": "^4.1.0"
  }
}
